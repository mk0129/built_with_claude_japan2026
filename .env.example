# ---- shiori (コードネーム) 環境変数の例。実値は .env.local に置き、Gitに入れない ----

# DB: 未設定ならローカル PGlite（.data/）を使う。Supabase の接続文字列を設定すると Postgres を使う
DATABASE_URL=
# テスト用: memory:// で PGlite をインメモリ実行
PGLITE_DATA=.data/shiori

# Better Auth
BETTER_AUTH_SECRET=change-me-32-chars-minimum-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# デモ認証（架空アカウントでのパスワードログイン）。本番（VERCEL_ENV=production または APP_ENV=production）では起動拒否
DEMO_AUTH=true
APP_ENV=development
DEMO_PASSWORD=shiori-demo-2026

# OAuth（P1。未設定ならボタンを無効表示）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# メール（P1。未設定なら OTP をサーバーログに出力）
RESEND_API_KEY=
MAIL_FROM=noreply@example.com

# 原資料の非公開ストレージ（Day4）。未設定ならローカル private_storage/（Git 対象外）。
# Supabase を使う場合は非公開バケットを作成し、サービスロールキーはサーバーの環境変数にだけ置く
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=source-documents

# Claude API（サーバー専用）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_HIGH=claude-opus-5-5
CLAUDE_TIMEOUT_MS=300000
CLAUDE_MAX_RETRIES=2
AI_JOB_MAX_ATTEMPTS=3
# Vercel Cron からのジョブ回収（/api/internal/jobs/drain）の認証
CRON_SECRET=
# 開発専用: API キーなしで画面を通す擬似生成（本番では無効。Claude の検証には使わない）
CLAUDE_FAKE=

# サービス名称（未定。UI表示用）
NEXT_PUBLIC_APP_NAME=しおり（仮）
