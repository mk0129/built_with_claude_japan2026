# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# shiori: local data, uploads, provisional design reference (rights unconfirmed)
/.data/
/uploads/
clinical_info_rx_ClaudeCode_spec_20261102/DESIGN_REFERENCE.png
/test-results/
/playwright-report/

# iCloud 同期が生成する重複ファイル
**/* [0-9].*

# 監修前の医学的図解（公開リポジトリに入れない。承認時に public/assets へ複製）
/private_assets/

# 原資料の非公開ストレージ（ローカル）
/private_storage/
