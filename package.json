{
  "name": "shiori",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-db.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node scripts/with-local-db.mjs tsx --env-file-if-exists=.env.local src/server/db/setup.ts",
    "auth:generate": "npx @better-auth/cli generate --config src/server/auth/auth.ts --output src/server/db/auth-schema.ts -y",
    "dev:next": "next dev",
    "db:local": "node scripts/with-local-db.mjs node -e \"setInterval(()=>{},1e9)\"",
    "db:setup:remote": "tsx --env-file-if-exists=.env.local src/server/db/setup.ts",
    "e2e": "playwright test",
    "e2e:fresh": "playwright test",
    "e2e:real": "E2E_CLAUDE=real E2E_SHOT_DIR=docs/screenshots/day5_real playwright test real_generation"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
